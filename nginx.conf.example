# ==============================================================================
# NGINX PRODUCTION CONFIGURATION FOR ECOTEX (VPS DEPLOYMENT)
# Copy or symlink to: /etc/nginx/sites-available/echotex
# Enable with: ln -s /etc/nginx/sites-available/echotex /etc/nginx/sites-enabled/
# Test with: nginx -t && systemctl reload nginx
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com; # Replace with your domain or VPS IP

    # Redirect all HTTP traffic to HTTPS (uncomment once SSL is installed via Certbot)
    # return 301 https://$host$request_uri;

    # Root directory pointing to the built frontend React SPA
    root /var/www/echotex/frontend/dist;
    index index.html;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;
    gzip_disable "MSIE [1-6]\.";

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Max upload body size for image uploads
    client_max_body_size 25M;

    # 1. API Reverse Proxy -> Node.js Backend (port 3001)
    location /api/ {
        proxy_pass http://127.0.0.1:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 90;
    }

    # 2. Uploads Directory Reverse Proxy -> Node.js Backend (port 3001)
    location /uploads/ {
        proxy_pass http://127.0.0.1:3001/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # 3. Static Assets Caching (Vite hashed bundles)
    location ~* \.(?:css|js|woff2?|eot|ttf|otf|png|jpg|jpeg|gif|webp|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # 4. Frontend SPA Router Fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
